<mxCell id="w1" value="&lt;b&gt;1. Get token&lt;/b&gt;&lt;br&gt;&lt;i&gt;OAuth client credentials&lt;/i&gt;&lt;br&gt;&lt;i&gt;reuse for ~18 min (Q14, Q16)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="wf"><mxGeometry x="340" y="50" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="fail" value="&lt;b&gt;On failure&lt;/b&gt;&lt;br&gt;&lt;i&gt;retry / alert / replay &amp;#8212; to confirm (Q14)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="wf"><mxGeometry x="20" y="150" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="w2" value='&lt;b&gt;2. Upsert consent row&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;PUT /hub/v1/dataevents/key:&amp;lt;DE&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;/rows/SubscriberKey:&amp;lt;key&amp;gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="wf"><mxGeometry x="340" y="150" width="240" height="70" as="geometry"/></mxCell>
