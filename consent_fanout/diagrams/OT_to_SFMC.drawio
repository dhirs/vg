<mxCell id="dyn" value="&lt;b&gt;Dynamics CRM &amp;#8594; SFMC sync&lt;/b&gt;&lt;br&gt;&lt;i&gt;existing &amp;#183; may overwrite consent fields (Q9)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lane_sfmc"><mxGeometry x="20" y="60" width="260" height="70" as="geometry"/></mxCell>
