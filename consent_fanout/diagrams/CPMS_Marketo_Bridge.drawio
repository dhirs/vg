<mxCell id="x9" value="then" edge="1" parent="1" source="q_bulk" target="b_lambda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;entryX=0.75;entryY=0;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
