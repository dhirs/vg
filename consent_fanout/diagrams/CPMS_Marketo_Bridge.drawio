<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="CPMS_Marketo_Bridge — OneTrust consent changes → every matching Marketo lead (proposed)" style="text;fontSize=20;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1400" height="30" as="geometry"/></mxCell>
<mxCell id="lane_ot" value="OneTrust" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="260" height="960" as="geometry"/></mxCell>
<mxCell id="lane_br" value="CPMS_Marketo_Bridge (AWS · not built)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="50" width="720" height="960" as="geometry"/></mxCell>
<mxCell id="lane_mk" value="Marketo" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="50" width="280" height="960" as="geometry"/></mxCell>
<UserObject label="&lt;b&gt;Consent updated in OneTrust&lt;/b&gt;&lt;br&gt;&lt;i&gt;from any source&lt;/i&gt;" tooltip="A person's consent changes in OneTrust&#10;From any source: the preference centre, a consent receipt, an admin edit." id="o_change"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="60" width="220" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Data Subject Consent Updated&lt;/b&gt;&lt;br&gt;&lt;i&gt;delta-type events off →&lt;/i&gt;&lt;br&gt;&lt;i&gt;fires on every change, full profile&lt;/i&gt;" tooltip="OneTrust event: Data Subject Consent Updated&#10;Delta-type events are off, so it fires on every change and carries the person's full current consent (with delta-type on it would only fire when a person is created).&#10;Filtered by purpose / collection point." id="o_event"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="170" width="220" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Integration workflow&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;POST /onetrust/consent-updated&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;x-cpms-webhook-key: …&lt;/font&gt;' tooltip="OneTrust integration workflow&#10;Posts the email and consent values to the bridge's endpoint, sending the shared secret in the x-cpms-webhook-key header." id="o_wf"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="300" width="220" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;POST /onetrust/consent-updated&lt;/font&gt;&lt;br&gt;&lt;i&gt;IP allowlist · throttling&lt;/i&gt;' tooltip="Endpoint — API Gateway route POST /onetrust/consent-updated&#10;Resource policy (or WAF): only OneTrust's outbound IP ranges get in.&#10;Route throttling; every rejection counted and alarmed so probing shows up." id="b_api"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_br"><mxGeometry x="20" y="300" width="200" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Authorizer + payload check&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-lambda-fanout-authorizer&lt;/font&gt;&lt;br&gt;&lt;i&gt;wrong secret → 401 · bad body → 400&lt;/i&gt;' tooltip="cpms-lambda-fanout-authorizer&#10;Compares x-cpms-webhook-key with cpms-secret-onetrust-webhook. Wrong or missing → 401, nothing queued.&#10;The body must validate against a schema (email + known purpose / topic / channel codes); otherwise → 400.&#10;Without this, anyone who finds the URL could change anyone's consent in Marketo." id="b_auth"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_br"><mxGeometry x="260" y="300" width="200" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-secret-onetrust-webhook&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-secret-marketo-api&lt;/font&gt;' tooltip="Secrets&#10;cpms-secret-onetrust-webhook: the shared secret OneTrust sends. Rotated by setting a new one in OneTrust and here together; both accepted briefly during the switch.&#10;cpms-secret-marketo-api: Marketo client ID and secret, used to get access tokens." id="b_secret"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_br"><mxGeometry x="500" y="60" width="200" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Urgent queue&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-sqs-fanout-marketo-urgent.fifo&lt;/font&gt;&lt;br&gt;&lt;i&gt;withdrawals · opt-outs&lt;/i&gt;' tooltip="Urgent FIFO queue — withdrawals and opt-outs&#10;Grouped by email, so one person's updates stay in order. Always drained first." id="q_urgent"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_br"><mxGeometry x="20" y="440" width="200" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Bulk queue&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-sqs-fanout-marketo-bulk.fifo&lt;/font&gt;&lt;br&gt;&lt;i&gt;opt-ins · re-syncs&lt;/i&gt;' tooltip="Bulk FIFO queue — opt-ins and re-syncs&#10;Grouped by email. Drained after the urgent queue, and paused for the day once a set share of Marketo's daily quota is used (e.g. 70%), so there's always room for opt-outs." id="q_bulk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_br"><mxGeometry x="260" y="440" width="200" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Dead-letter queue + alarm&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-sqs-fanout-marketo-dlq.fifo&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-alarm-fanout-marketo&lt;/font&gt;' tooltip="Failures are never silent&#10;Anything that still fails after retries goes to cpms-sqs-fanout-marketo-dlq.fifo and raises cpms-alarm-fanout-marketo — kept for replay.&#10;The same alarm covers endpoint rejections and the quota nearing its limit." id="b_dlq"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane_br"><mxGeometry x="500" y="440" width="200" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Fanout Lambda&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-lambda-fanout-marketo&lt;/font&gt;&lt;br&gt;&lt;i&gt;batch ≤ 300 or ~30 s · latest state per person&lt;/i&gt;&lt;br&gt;&lt;i&gt;urgent first · bulk paused at ~70% quota&lt;/i&gt;' tooltip="cpms-lambda-fanout-marketo&#10;Gathers updates for a short window (e.g. 30 seconds, or until it has 300), keeps only each person's latest state, then handles the batch with one lookup and one update call: about 2 calls per 300 people (a 40,000-person re-push ≈ 270 calls instead of ≈ 80,000).&#10;Urgent queue first; before draining the bulk queue it checks today's usage and pauses bulk near the limit.&#10;&quot;Re-push everyone&quot; (e.g. after a taxonomy change) uses Marketo's Bulk Import (one CSV) instead of API calls." id="b_lambda"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_br"><mxGeometry x="20" y="570" width="440" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Watermark check&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;S3 cpms/fanout-watermarks/marketo/&lt;/font&gt;&lt;br&gt;&lt;i&gt;drop anything older than the last write&lt;/i&gt;' tooltip="Per-person watermark — never write an older state over a newer one&#10;Two queues and batching mean one person's changes can be handled out of order.&#10;Example: Jane opts in at 10:00 (bulk) and opts out of everything at 10:05 (urgent). The opt-out is written first; the 10:00 opt-in is older than the 10:05 watermark, so it's dropped.&#10;The watermark (OneTrust timestamp of the last state written, per email) moves only after Marketo confirms the write, with a conditional S3 write." id="b_wm"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_br"><mxGeometry x="500" y="570" width="200" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Per batch&lt;/b&gt;&lt;br&gt;1. token — reused until just before it expires&lt;br&gt;2. find &lt;b&gt;every&lt;/b&gt; lead for up to 300 emails&lt;br&gt;3. update by lead ID — up to 300 leads per call&lt;br&gt;4. check today's API usage (before bulk)&lt;br&gt;&lt;i&gt;606 / expired token → retry at once&lt;/i&gt;" tooltip="Updating Marketo, per batch&#10;1. Token: GET /identity/oauth/token with client credentials; reused until just before it expires, never one per call.&#10;2. Find the leads: GET /rest/v1/leads.json?filterType=email&amp;amp;filterValues=&amp;lt;up to 300 emails&amp;gt; — returns every lead, since Marketo can hold several per email.&#10;3. Update: POST /rest/v1/leads.json, action updateOnly, lookupField id, up to 300 leads per call; never over 100 calls / 20 s or 10 concurrent.&#10;4. Quota: today's usage from Marketo's usage API before draining the bulk queue.&#10;Rate-limit (606) and expired-token errors are retried straight away; still failing → dead-letter queue." id="b_steps"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_br"><mxGeometry x="20" y="710" width="440" height="160" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /identity/oauth/token&lt;/font&gt;' tooltip="Marketo access token&#10;Client credentials (client ID + secret). Short-lived — reused until just before it expires." id="m_token"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_mk"><mxGeometry x="20" y="690" width="240" height="44" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Get leads by email&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /rest/v1/leads.json?filterType=email&lt;/font&gt;' tooltip="Get Leads by filter type&#10;Up to 300 emails per call; returns every lead with those emails." id="m_lookup"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_mk"><mxGeometry x="20" y="742" width="240" height="50" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Sync leads (updateOnly)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;POST /rest/v1/leads.json&lt;/font&gt;' tooltip="Sync Leads — action updateOnly, lookupField id&#10;Up to 300 leads per call. Never creates leads." id="m_update"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_mk"><mxGeometry x="20" y="800" width="240" height="44" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Usage API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;today's API calls used&lt;/font&gt;" tooltip="Marketo usage API&#10;Today's call count against the daily quota (typically 50,000, shared by everything using the instance)." id="m_usage"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_mk"><mxGeometry x="20" y="852" width="240" height="44" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Smart lists, programs &amp;amp; sends&lt;/b&gt;&lt;br&gt;&lt;i&gt;filter on the updated consent fields&lt;/i&gt;" tooltip="Marketo sends&#10;Smart lists and programs filter on the consent fields the bridge updates, so an opt-out stops the next send." id="m_sends"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_mk"><mxGeometry x="20" y="540" width="240" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Marketo API limits&lt;/b&gt;&lt;br&gt;&lt;i&gt;100 calls / 20 s · 10 concurrent (fixed)&lt;/i&gt;&lt;br&gt;&lt;i&gt;~50,000 calls / day · 300 per batch&lt;/i&gt;" tooltip="Marketo API limits the bridge is designed around&#10;100 calls per 20 seconds and 10 concurrent — fixed, shared by everything using the instance (CRM sync, other tools).&#10;Daily quota typically 50,000 calls (can be raised by purchase). Up to 300 records per call." id="m_limits"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lane_mk"><mxGeometry x="20" y="60" width="240" height="80" as="geometry"/></mxCell></UserObject>
