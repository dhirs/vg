<mxCell id="x4" value="key (encrypt)" edge="1" parent="1" source="r_key" target="w_page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x5" value="local ID" edge="1" parent="1" source="r_decrypt" target="r_crm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
