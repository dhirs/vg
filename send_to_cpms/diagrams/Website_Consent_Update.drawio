<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Website_Consent_Update — signed-in Vanguard 365 user → OneTrust's preference centre (proposed)" style="text;fontSize=20;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1300" height="30" as="geometry"/></mxCell>
<mxCell id="lane_web" value="Vanguard 365 website" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="280" height="790" as="geometry"/></mxCell>
<mxCell id="lane_app" value="CPMS_Router (AWS · not built)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="50" width="320" height="790" as="geometry"/></mxCell>
<mxCell id="lane_crm" value="CRM" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="50" width="280" height="790" as="geometry"/></mxCell>
<mxCell id="lane_ot" value="OneTrust" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="50" width="300" height="790" as="geometry"/></mxCell>
<UserObject label="&lt;b&gt;Sign in to Vanguard 365&lt;/b&gt;&lt;br&gt;&lt;i&gt;secure portal session&lt;/i&gt;" tooltip="Sign in to Vanguard 365 (secure portal)&#10;The person must have a Vanguard 365 session before the preferences link is shown.&#10;Dev: simulated — any email in the stub CRM, no password, in-memory session cookie." id="w_signin"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_web"><mxGeometry x="20" y="60" width="240" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Preferences page&lt;/b&gt;&lt;br&gt;&lt;i&gt;renders the link with a short-lived ref&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;/website/preferences?ref=…&lt;/font&gt;' tooltip="Preferences page (Vanguard 365 page backend)&#10;When it renders the page for the signed-in user, it encrypts their local ID plus the issue time:&#10;ref = AES-256-GCM(localId + issuedAt), key cpms-secret-web-ref-key, additional data &quot;cpms-web-ref:v1&quot;, format v1.&amp;lt;iv&amp;gt;.&amp;lt;ciphertext+tag&amp;gt;.&#10;The link points at CPMS_Router's website route. CPMS_Router can't see the Vanguard 365 session, so this ref is the link's only credential — short-lived (e.g. 10 minutes) so a copied link soon stops working." id="w_page"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_web"><mxGeometry x="20" y="190" width="240" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-secret-web-ref-key&lt;/font&gt;' tooltip="cpms-secret-web-ref-key&#10;256-bit AES key(s) by version, separate from the Marketo key — so a website ref can't be used on the Marketo route, or the other way round.&#10;Readable by cpms-lambda-router-website (decrypt) and the Vanguard 365 page backend (encrypt). How the website gets access — e.g. cross-account Secrets Manager — to confirm." id="r_key"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_app"><mxGeometry x="20" y="60" width="280" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;1. Validate &amp;amp; decrypt ref&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /website/preferences&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-lambda-router-website&lt;/font&gt;' tooltip="CPMS_Router website route — GET /website/preferences (API Gateway cpms-apigw-router) → Lambda cpms-lambda-router-website&#10;The route itself says the ref is a website-issued local ID — no source parameter. Its own Lambda, secrets and throttling, separate from the Marketo route.&#10;1. Reject a ref that's missing, too long or not shaped v&amp;lt;n&amp;gt;.&amp;lt;base64url&amp;gt;.&amp;lt;base64url&amp;gt;.&#10;2. Pick the key for its version; AES-256-GCM decrypt with additional data &quot;cpms-web-ref:v&amp;lt;n&amp;gt;&quot;. Tag doesn't verify → forged or edited → reject.&#10;3. Plaintext = local ID + issue time; older than the allowed age (e.g. 10 minutes) → reject.&#10;Every rejection: one generic &quot;invalid or expired link&quot; page, counted." id="r_decrypt"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="190" width="280" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;2. CRM lookup&lt;/b&gt;&lt;br&gt;&lt;i&gt;local ID → email&lt;/i&gt;" tooltip="2. CRM lookup&#10;Local ID → email. The email is worked out on the server, never taken from the browser.&#10;CRM API credentials are readable only by this Lambda." id="r_crm"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="320" width="280" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;3. Get OneTrust magic link&lt;/b&gt;&lt;br&gt;&lt;i&gt;email → link token&lt;/i&gt;" tooltip="3. OneTrust magic link (shared router module)&#10;Calls Get Data Subject Token with the email as the identifier header; appends the URL-encoded token to the preference centre URL.&#10;Same code as the Marketo route — lambdas/shared/router.py." id="r_magic"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="450" width="280" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;4. Redirect&lt;/b&gt;&lt;br&gt;&lt;i&gt;302 to the magic link&lt;/i&gt;" tooltip="4. Redirect&#10;The browser is sent to OneTrust's preference centre with the person's magic link.&#10;Our side stops here: no settings are read or changed, and nothing is sent to CPMS." id="r_redirect"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="580" width="280" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;i&gt;local ID ↔ email&lt;/i&gt;&lt;br&gt;&lt;i&gt;(stub in dev)&lt;/i&gt;" tooltip="CRM&#10;Maps the local ID to the person's email.&#10;Dev: stub CRM, web/data/stub-crm.json (git-ignored). Every EMO / CL6 registration adds its person." id="c_crm"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_crm"><mxGeometry x="20" y="320" width="240" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Get Data Subject Token&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /rest/api/consent/v4/&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;datasubjects/linktokens&lt;/font&gt;&lt;br&gt;&lt;i&gt;header identifier: email&lt;/i&gt;' tooltip="OneTrust — Get Data Subject Token&#10;GET https://&amp;lt;hostname&amp;gt;/rest/api/consent/v4/datasubjects/linktokens, header identifier: &amp;lt;email&amp;gt;, OAuth scope CONSENT.&#10;Returns token, createdDate, expiryDate. To confirm: what it returns for someone with no token yet." id="o_token"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="440" width="260" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Hosted preference centre&lt;/b&gt;&lt;br&gt;&lt;i&gt;person reviews and changes preferences;&lt;/i&gt;&lt;br&gt;&lt;i&gt;OneTrust records the change&lt;/i&gt;" tooltip="OneTrust's hosted preference centre&#10;Opens for the person in the magic link. They see their current settings and change them; OneTrust records the change itself.&#10;Dev: a local stand-in page (#/onetrust?token=…) until a tenant is connected." id="o_pc"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="570" width="260" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Consent fanout&lt;/b&gt;&lt;br&gt;&lt;i&gt;OneTrust → SFMC, OneTrust → AEP&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;consent_fanout/&lt;/font&gt;' tooltip="Consent fanout (consent_fanout/)&#10;Once OneTrust has recorded the change, it reaches downstream systems: OT → SFMC (OneTrust workflow) and OT → AEP (OneTrust Integration source)." id="o_fanout"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="700" width="260" height="50" as="geometry"/></mxCell></UserObject>
<mxCell id="x1" value="signed in" edge="1" parent="1" source="w_signin" target="w_page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
