<mxCell id="x7" value="email" edge="1" parent="1" source="r_crm" target="r_magic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
