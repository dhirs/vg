<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Website_Consent_Update — signed-in Vanguard 365 user → OneTrust's preference centre (proposed)" style="text;fontSize=20;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1300" height="30" as="geometry"/></mxCell>
<mxCell id="lane_web" value="Vanguard 365 website" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="280" height="790" as="geometry"/></mxCell>
<mxCell id="lane_app" value="Website backend (AWS · not built)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="50" width="320" height="790" as="geometry"/></mxCell>
<mxCell id="lane_crm" value="CRM" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="50" width="280" height="790" as="geometry"/></mxCell>
<mxCell id="lane_ot" value="OneTrust" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="50" width="300" height="790" as="geometry"/></mxCell>
<UserObject label="&lt;b&gt;Sign in to Vanguard 365&lt;/b&gt;&lt;br&gt;&lt;i&gt;secure portal session&lt;/i&gt;" tooltip="Sign in to Vanguard 365 (secure portal)&#10;The person must have a Vanguard 365 session before anything else; if not, they sign in first.&#10;Dev: simulated — any email in the stub CRM, no password, in-memory session cookie." id="w_signin"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_web"><mxGeometry x="20" y="60" width="240" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Preferences page&lt;/b&gt;&lt;br&gt;&lt;i&gt;Manage my preferences →&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;…/preferences?localId=CL6-…&lt;/font&gt;' tooltip="Preferences page&#10;Offers the signed-in user a personal link carrying their local ID (their CL6 / CRM identifier), e.g. …/preferences?localId=CL6-100234.&#10;The link alone is never enough — the backend checks it against the session." id="w_page"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_web"><mxGeometry x="20" y="190" width="240" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;1. Session check&lt;/b&gt;&lt;br&gt;&lt;i&gt;the link's local ID must be&lt;/i&gt;&lt;br&gt;&lt;i&gt;the signed-in user's&lt;/i&gt;" tooltip='1. Session check&#10;Not signed in → sign in first.&#10;The local ID in the link must belong to the signed-in user; anything else is refused ("This link belongs to a different user"), so editing the ID in the URL gets nothing.' id="b_session"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="190" width="280" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;2. CRM lookup&lt;/b&gt;&lt;br&gt;&lt;i&gt;local ID → email&lt;/i&gt;" tooltip="2. CRM lookup&#10;Local ID → email, for the signed-in user only.&#10;The email is worked out on the server, never taken from the browser." id="b_crm"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="320" width="280" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;3. Get OneTrust magic link&lt;/b&gt;&lt;br&gt;&lt;i&gt;email → link token&lt;/i&gt;" tooltip="3. OneTrust magic link&#10;Calls Get Data Subject Token with the email as the identifier header; appends the URL-encoded token to the preference centre URL.&#10;Backend only — the token request never happens in the browser." id="b_magic"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="450" width="280" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;4. Redirect&lt;/b&gt;&lt;br&gt;&lt;i&gt;302 to the magic link&lt;/i&gt;" tooltip="4. Redirect&#10;The browser is sent to OneTrust's preference centre with the person's magic link.&#10;Our side stops here: no settings are read or changed by our pages, and nothing is sent to CPMS." id="b_redirect"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="580" width="280" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;i&gt;local ID ↔ email&lt;/i&gt;&lt;br&gt;&lt;i&gt;(stub in dev)&lt;/i&gt;" tooltip="CRM&#10;Maps the local ID to the person's email.&#10;Dev: stub CRM, web/data/stub-crm.json (git-ignored). Every EMO / CL6 registration adds its person.&#10;Prod: CRM API credentials held server-side only (design.md → Open items)." id="c_crm"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_crm"><mxGeometry x="20" y="320" width="240" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Get Data Subject Token&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /rest/api/consent/v4/&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;datasubjects/linktokens&lt;/font&gt;&lt;br&gt;&lt;i&gt;header identifier: email&lt;/i&gt;' tooltip="OneTrust — Get Data Subject Token&#10;GET https://&amp;lt;hostname&amp;gt;/rest/api/consent/v4/datasubjects/linktokens, header identifier: &amp;lt;email&amp;gt;, OAuth scope CONSENT.&#10;Returns token, createdDate, expiryDate. To confirm: what it returns for someone with no token yet." id="o_token"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="440" width="260" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Hosted preference centre&lt;/b&gt;&lt;br&gt;&lt;i&gt;person reviews and changes preferences;&lt;/i&gt;&lt;br&gt;&lt;i&gt;OneTrust records the change&lt;/i&gt;" tooltip="OneTrust's hosted preference centre&#10;Opens for the person in the magic link. They see their current settings and change them; OneTrust records the change itself.&#10;Dev: a local stand-in page (#/onetrust?token=…) until a tenant is connected." id="o_pc"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="570" width="260" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Consent fanout&lt;/b&gt;&lt;br&gt;&lt;i&gt;OneTrust → SFMC, OneTrust → AEP&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;consent_fanout/&lt;/font&gt;' tooltip="Consent fanout (consent_fanout/)&#10;Once OneTrust has recorded the change, it reaches downstream systems: OT → SFMC (OneTrust workflow) and OT → AEP (OneTrust Integration source)." id="o_fanout"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="700" width="260" height="50" as="geometry"/></mxCell></UserObject>
<mxCell id="x1" value="signed in" edge="1" parent="1" source="w_signin" target="w_page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x2" value="click · ?localId=…" edge="1" parent="1" source="w_page" target="b_session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x3" value="local ID" edge="1" parent="1" source="b_session" target="b_crm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
