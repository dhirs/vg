<mxCell id="x9" value="" edge="1" parent="1" source="r_magic" target="r_redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x10" value="302 · magic link" edge="1" parent="1" source="r_redirect" target="o_pc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x11" value="change recorded" edge="1" parent="1" source="o_pc" target="o_fanout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
