<mxCell id="x5" value="email" edge="1" parent="1" source="b_crm" target="b_magic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x6" value="identifier: email" edge="1" parent="1" source="b_magic" target="o_token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x7" value="" edge="1" parent="1" source="b_magic" target="b_redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x8" value="302 · magic link" edge="1" parent="1" source="b_redirect" target="o_pc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x9" value="change recorded" edge="1" parent="1" source="o_pc" target="o_fanout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
