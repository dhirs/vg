<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Email_OneClick_Unsubscribe — Gmail one-click (List-Unsubscribe header) → OneTrust withdrawal, no page (proposed)" style="text;fontSize=20;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1600" height="30" as="geometry"/></mxCell>
<mxCell id="lane_gmail" value="Gmail (mailbox provider)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="280" height="900" as="geometry"/></mxCell>
<mxCell id="lane_mkto" value="Marketo" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="50" width="280" height="900" as="geometry"/></mxCell>
<mxCell id="lane_ep" value="CPMS one-click endpoint (AWS · not built)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="50" width="300" height="900" as="geometry"/></mxCell>
<mxCell id="lane_cpms" value="CPMS pipeline (AWS · built, shared by all sources)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="50" width="300" height="900" as="geometry"/></mxCell>
<mxCell id="lane_ot" value="OneTrust" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="50" width="280" height="900" as="geometry"/></mxCell>
<UserObject label='&lt;b&gt;Marketing email&lt;/b&gt;&lt;br&gt;&lt;i&gt;headers Marketo adds, DKIM-signed:&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;List-Unsubscribe: &amp;lt;https://&amp;lt;cpms-host&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;/marketo/unsubscribe?ref={{lead.cpmsPrefRef}}&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;List-Unsubscribe-Post: List-Unsubscribe=One-Click&lt;/font&gt;' tooltip="Marketing email sent by Marketo&#10;The two headers make Gmail show its own Unsubscribe button next to the sender.&#10;ref is the same pre-encrypted lead ID the body link uses (cpmsPrefRef) — no new token.&#10;The headers must be covered by the DKIM signature or Gmail ignores them.&#10;To confirm: Marketo lets us point List-Unsubscribe at our URL (consent_fanout/Marketo.md)." id="m_email"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_mkto"><mxGeometry x="20" y="60" width="240" height="120" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;REST API: Get Lead by Id&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /rest/v1/lead/&amp;lt;id&amp;gt;.json&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;?fields=email,cpmsPrefRef&lt;/font&gt;' tooltip="Marketo REST API — Get Lead by Id. Returns the lead's email and stored cpmsPrefRef." id="m_api"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_mkto"><mxGeometry x="20" y="330" width="240" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Unsubscribe button&lt;/b&gt;&lt;br&gt;&lt;i&gt;next to the sender; Gmail asks&lt;/i&gt;&lt;br&gt;&lt;i&gt;“Unsubscribe from …?” in its own UI&lt;/i&gt;" tooltip="Gmail's Unsubscribe button&#10;Shown because of the List-Unsubscribe-Post header. The confirmation is Gmail's own dialog — the person never leaves the inbox and no page of ours opens." id="g_button"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_gmail"><mxGeometry x="20" y="60" width="240" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Gmail's servers POST&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;POST &amp;lt;List-Unsubscribe URL&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;List-Unsubscribe=One-Click&lt;/font&gt;" tooltip="RFC 8058 one-click POST&#10;Sent from Google's servers, not the browser: no cookies, no redirects followed, no page shown.&#10;POST only, so link scanners that GET URLs can't unsubscribe anyone." id="g_post"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_gmail"><mxGeometry x="20" y="200" width="240" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;“Unsubscribed”&lt;/b&gt;&lt;br&gt;&lt;i&gt;shown in Gmail&lt;/i&gt;" tooltip="Gmail shows the result in the inbox on a 2xx answer. The person is done." id="g_done"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_gmail"><mxGeometry x="20" y="470" width="240" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-secret-pref-ref-key&lt;/font&gt;' tooltip="cpms-secret-pref-ref-key&#10;The same AES key(s) the email link route uses to decrypt cpmsPrefRef." id="a_key"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_ep"><mxGeometry x="30" y="60" width="240" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;1. Check &amp;amp; decrypt ref&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;POST /marketo/unsubscribe&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-lambda-oneclick-unsub&lt;/font&gt;' tooltip="API Gateway → cpms-lambda-oneclick-unsub&#10;1. Body must be List-Unsubscribe=One-Click (anything else → 400).&#10;2. Validate and AES-256-GCM decrypt the ref, as the email link route does → lead ID.&#10;No redirect, no page." id="a_check"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_ep"><mxGeometry x="30" y="200" width="240" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;2. Marketo lookup&lt;/b&gt;&lt;br&gt;&lt;i&gt;email; stored cpmsPrefRef must match&lt;/i&gt;" tooltip="Get Lead by Id for the decrypted lead ID. No lead, or the stored cpmsPrefRef differs (revoked) → reject." id="a_lookup"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_ep"><mxGeometry x="30" y="330" width="240" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;3. Publish withdrawal&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;sourceSystem: email_oneclick&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;marketing_communications: withdrawn&lt;/font&gt;' tooltip="A standard source_event, like EMO/CL6 send:&#10;eventType email_unsubscribe, sourceSystem email_oneclick,&#10;consent[] = marketing_communications · withdrawn · captureMethod list_unsubscribe_one_click.&#10;PutEvents to cpms-eventbus-consent (source cpms.email_oneclick)." id="a_publish"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_ep"><mxGeometry x="30" y="450" width="240" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;4. 200 OK&lt;/b&gt;&lt;br&gt;&lt;i&gt;straight away — no page&lt;/i&gt;" tooltip="Answers Gmail as soon as the event is on the bus; the rest happens asynchronously.&#10;Gmail/Yahoo rule: honour the opt-out within 2 days." id="a_200"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_ep"><mxGeometry x="30" y="590" width="240" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Ingestion&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-eventbus-consent&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;→ cpms-sqs-ingestion.fifo&lt;/font&gt;' tooltip="Existing ingestion: the rule takes any cpms.* source, so a new source needs no change here." id="p_bus"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_cpms"><mxGeometry x="30" y="450" width="240" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Step Function&lt;/b&gt;&lt;br&gt;&lt;i&gt;validate → canonical → stale filter&lt;/i&gt;&lt;br&gt;&lt;i&gt;→ build OneTrust receipt&lt;/i&gt;" tooltip="The same state machine every source uses. A withdrawn purpose also turns off all its topics (design.md step 2).&#10;Unchanged for this flow." id="p_sfn"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_cpms"><mxGeometry x="30" y="590" width="240" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Outbound&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-sqs-outbound.fifo → dispatcher&lt;/font&gt;' tooltip="Queued until we have OneTrust API access; the dispatcher then POSTs it." id="p_out"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_cpms"><mxGeometry x="30" y="730" width="240" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Consent receipt&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;POST /request/v1/consentreceipts&lt;/font&gt;&lt;br&gt;&lt;i&gt;TransactionType WITHDRAWN&lt;/i&gt;' tooltip='OneTrust records the withdrawal, through its own collection point (proposed: "Vanguard Email One-Click") so the audit trail shows it came from the Gmail button.&#10;To build: the sourceSystem → collection point mapping.' id="o_receipt"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="720" width="240" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Consent fanout&lt;/b&gt;&lt;br&gt;&lt;i&gt;OneTrust → Marketo, SFMC, …&lt;/i&gt;" tooltip="consent_fanout/: the withdrawal reaches Marketo, which stops sending. Open: does that round trip meet the 2-day deadline?" id="o_fanout"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="830" width="240" height="50" as="geometry"/></mxCell></UserObject>
