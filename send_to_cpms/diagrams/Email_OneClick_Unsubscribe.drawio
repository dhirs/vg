<mxCell id="e2" value="confirm" edge="1" parent="1" source="g_button" target="g_post" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
