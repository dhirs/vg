<mxCell id="e7" value="email" edge="1" parent="1" source="a_lookup" target="a_publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="source_event" edge="1" parent="1" source="a_publish" target="p_bus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="" edge="1" parent="1" source="a_publish" target="a_200" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="200" edge="1" parent="1" source="a_200" target="g_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="" edge="1" parent="1" source="p_bus" target="p_sfn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="" edge="1" parent="1" source="p_sfn" target="p_out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="WITHDRAWN" edge="1" parent="1" source="p_out" target="o_receipt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="change recorded" edge="1" parent="1" source="o_receipt" target="o_fanout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="legend" value="Hover over a box for full detail. Purple = proposed (not built) · green = built / existing · blue = external API · grey dashed = other flow. Unlike Email_Consent_Update there is no browser and no page: Gmail calls CPMS directly." style="text;whiteSpace=wrap;html=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1600" height="30" as="geometry"/></mxCell>
</root></mxGraphModel>
