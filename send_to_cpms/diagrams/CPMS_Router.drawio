<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="CPMS_Router — one link per system, the OneTrust magic link fetched at click time (proposed)" style="text;fontSize=20;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1500" height="30" as="geometry"/></mxCell>
<mxCell id="lane_src" value="Systems that print links" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="260" height="700" as="geometry"/></mxCell>
<mxCell id="lane_rt" value="CPMS_Router (AWS · not built)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="50" width="640" height="700" as="geometry"/></mxCell>
<mxCell id="lane_sor" value="Systems of record" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="50" width="260" height="700" as="geometry"/></mxCell>
<mxCell id="lane_ot" value="OneTrust" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="50" width="280" height="700" as="geometry"/></mxCell>
<UserObject label='&lt;b&gt;Marketo email&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;/marketo/preferences&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;?ref={{lead.cpmsPrefRef}}&lt;/font&gt;' tooltip="Marketo email&#10;Prints the lead's pre-encrypted lead ID (cpmsPrefRef, filled once per lead by the ref issuer webhook).&#10;No OneTrust link is stored in Marketo." id="s_mkto"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_src"><mxGeometry x="20" y="60" width="220" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Vanguard 365 website&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;/website/preferences&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;?ref=…&lt;/font&gt;' tooltip="Vanguard 365 website (signed-in user)&#10;Encrypts the user's CRM local ID plus the issue time when it renders the page — a short-lived ref (e.g. 10 minutes).&#10;No OneTrust link is stored on the website." id="s_web"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_src"><mxGeometry x="20" y="200" width="220" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Next system&lt;/b&gt;&lt;br&gt;&lt;i&gt;AEP / Journey Optimizer, Dynamics CRM,&lt;/i&gt;&lt;br&gt;&lt;i&gt;SFMC, an app…&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;/&amp;lt;system&amp;gt;/preferences?ref=…&lt;/font&gt;' tooltip="Any further system&#10;Gets its own route, its own Lambda and its own key; prints its own encrypted ID for the person.&#10;Nothing to seed into it and nothing to keep in sync, and nothing changes in OneTrust or in the other systems." id="s_next"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lane_src"><mxGeometry x="20" y="340" width="220" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Nothing seeded&lt;/b&gt;&lt;br&gt;&lt;i&gt;no system stores a OneTrust link —&lt;/i&gt;&lt;br&gt;&lt;i&gt;only its own encrypted ID&lt;/i&gt;" tooltip="Why the router exists&#10;Without it, every system would need each person's OneTrust magic link seeded and kept in sync (email changes, removals, reissued tokens), and the links would have to be either permanent (a security risk) or short-lived (dead links in sent emails).&#10;With it, the magic link is fetched per click and never stored. See CPMS Router → OneTrust magic links / What is CPMS Router." id="s_note"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lane_src"><mxGeometry x="20" y="500" width="220" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-apigw-router&lt;/font&gt;&lt;br&gt;&lt;i&gt;one route per system&lt;/i&gt;&lt;br&gt;&lt;i&gt;throttled per route&lt;/i&gt;' tooltip="API Gateway HTTP API — cpms-apigw-router&#10;Exposes one route per system and nothing else. The route a link points at tells the router where the ID came from — there's no &quot;source&quot; parameter.&#10;Each route is throttled on its own, so a campaign send can't starve website users." id="r_api"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_rt"><mxGeometry x="20" y="60" width="170" height="370" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Marketo route&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /marketo/preferences → cpms-lambda-router-marketo&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;key: cpms-secret-pref-ref-key&lt;/font&gt;' tooltip="GET /marketo/preferences → cpms-lambda-router-marketo&#10;Decrypts ref → lead ID; Marketo Get Lead by Id → email, checking the lead's stored cpmsPrefRef matches (revocation); then the shared module gets the magic link and redirects.&#10;Reads only cpms-secret-pref-ref-key and the Marketo API credentials." id="r_mkto"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_rt"><mxGeometry x="230" y="60" width="380" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Website route&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /website/preferences → cpms-lambda-router-website&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;key: cpms-secret-web-ref-key&lt;/font&gt;' tooltip="GET /website/preferences → cpms-lambda-router-website&#10;Decrypts ref → local ID + issue time; refuses it if too old; CRM → email; then the shared module gets the magic link and redirects.&#10;Reads only cpms-secret-web-ref-key and the CRM API credentials." id="r_web"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_rt"><mxGeometry x="230" y="200" width="380" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Next route&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /&amp;lt;system&amp;gt;/preferences → cpms-lambda-router-&amp;lt;system&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;key: cpms-secret-&amp;lt;system&amp;gt;-ref-key&lt;/font&gt;' tooltip="GET /&amp;lt;system&amp;gt;/preferences → cpms-lambda-router-&amp;lt;system&amp;gt;&#10;Same shape: decrypt with its own key → look up the email in that system's record → shared module.&#10;Separate Lambda and secrets, so one route's compromise doesn't expose another's." id="r_next"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lane_rt"><mxGeometry x="230" y="345" width="380" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Shared router module&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;lambdas/shared/router.py&lt;/font&gt;&lt;br&gt;&lt;i&gt;decrypt · OneTrust magic link · 302 · generic error page · logging&lt;/i&gt;' tooltip='Shared router module — lambdas/shared/router.py (like lambdas/shared/watermark.py)&#10;What every route does the same way:&#10;- AES-256-GCM decrypt with key versions (each route passes its own key and additional data)&#10;- OneTrust Get Data Subject Token → magic link URL&#10;- the 302 redirect&#10;- the one generic "this link is invalid or has expired" page for every rejection, and failure counting&#10;- never logging ID, ref and email together in plain text' id="r_shared"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_rt"><mxGeometry x="20" y="500" width="590" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Marketo REST API&lt;/b&gt;&lt;br&gt;&lt;i&gt;lead ID → email&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ stored cpmsPrefRef&lt;/i&gt;" tooltip="Marketo — Get Lead by Id&#10;GET https://&amp;lt;munchkin-id&amp;gt;.mktorest.com/rest/v1/lead/&amp;lt;leadId&amp;gt;.json?fields=email,cpmsPrefRef&#10;The email is always the current one at click time." id="d_mkto"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_sor"><mxGeometry x="20" y="60" width="220" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;i&gt;local ID → email&lt;/i&gt;" tooltip="CRM&#10;Local ID → the person's current email at click time. Stubbed in the test app (web/data/stub-crm.json)." id="d_crm"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_sor"><mxGeometry x="20" y="200" width="220" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Its system of record&lt;/b&gt;&lt;br&gt;&lt;i&gt;its ID → email&lt;/i&gt;" tooltip="The next system's own lookup&#10;That system's API, or the CRM — whatever owns its ID." id="d_next"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lane_sor"><mxGeometry x="20" y="345" width="220" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Get Data Subject Token&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /rest/api/consent/v4/&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;datasubjects/linktokens&lt;/font&gt;&lt;br&gt;&lt;i&gt;header identifier: email&lt;/i&gt;' tooltip="OneTrust — Get Data Subject Token&#10;GET https://&amp;lt;hostname&amp;gt;/rest/api/consent/v4/datasubjects/linktokens, header identifier: &amp;lt;email&amp;gt;, OAuth scope CONSENT.&#10;Called per click; the magic link is never stored." id="o_token"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="490" width="240" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Hosted preference centre&lt;/b&gt;&lt;br&gt;&lt;i&gt;latest settings; OneTrust&lt;/i&gt;&lt;br&gt;&lt;i&gt;records any change&lt;/i&gt;" tooltip="OneTrust's hosted preference centre&#10;Opens for the person in the magic link with their latest settings; OneTrust records any change, and the consent fanout (OT → SFMC, OT → AEP) takes it from there." id="o_pc"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="610" width="240" height="70" as="geometry"/></mxCell></UserObject>
