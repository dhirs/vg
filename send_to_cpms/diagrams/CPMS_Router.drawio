<mxCell id="x9" value="its ID" edge="1" parent="1" source="r_next" target="d_next" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
