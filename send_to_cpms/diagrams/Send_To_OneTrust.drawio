<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="send_to_cpms &#8212; source triggers &#8594; OneTrust (dev, as built)" style="text;fontSize=20;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="30" as="geometry"/></mxCell>
<UserObject label="&lt;b&gt;Sources&lt;/b&gt;&lt;br&gt;&lt;i&gt;portal, Cvent, Kaltura, preference form&lt;/i&gt;" tooltip="Sources&#10;Systems where a person gives or changes consent: secure portal / CL6 account registration, EMO event registration (Cvent, Kaltura), the preference centre.&#10;Each publishes a generic source_event to the bus — contract: schemas/source_event.schema.json.&#10;The email must be sent already lowercased (the rule can't transform it)." id="sources"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="260" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;EventBridge bus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-eventbus-consent&lt;/font&gt;" tooltip="EventBridge bus — cpms-eventbus-consent&#10;Entry point for every source. Each source publishes its source_event here.&#10;Created by deploy/setup_ingestion.py." id="eb"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="160" width="260" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;EventBridge rule&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-rule-ingest&lt;/font&gt;&lt;br&gt;&lt;i&gt;all cpms.* events&lt;/i&gt;" tooltip="EventBridge rule — cpms-rule-ingest&#10;Sends every cpms.* event to the ingestion FIFO queue: no per-source routing, because one state machine serves all sources.&#10;Targets the queue, not the state machine, to keep per-person ordering.&#10;Sets MessageGroupId from $.detail.subject.identifierValue (the email) — no Lambda in between. Limits: no prefix/suffix, no lowercasing, value ≤ 100 chars." id="router"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="260" height="64" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Ingestion FIFO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-sqs-ingestion.fifo&lt;/font&gt;&lt;br&gt;&lt;i&gt;MessageGroupId = email&lt;/i&gt;" tooltip="Ingestion FIFO — cpms-sqs-ingestion.fifo&#10;MessageGroupId = email: one person's events are released strictly in order, one at a time; different people run in parallel.&#10;Prevents a newer event finishing (and enqueuing) before an older one and being overwritten at OneTrust.&#10;Content-based dedup, high-throughput mode, visibility timeout 6× the consumer timeout, redrive to the ingestion DLQ after 5 receives." id="ingfifo"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="384" width="260" height="64" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;FIFO consumer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-lambda-fifo-consumer&lt;/font&gt;&lt;br&gt;&lt;i&gt;waits for each run&lt;/i&gt;" tooltip="FIFO consumer — cpms-lambda-fifo-consumer&#10;SQS event source mapping, batch size 1. Calls StartSyncExecution and waits for the run to finish before acknowledging — this is what enforces one run at a time per person.&#10;Raises (→ SQS retry, DLQ after 5) only when the run itself FAILED; a rejected event ends SUCCEEDED and is acknowledged.&#10;Code: lambdas/fifo_consumer/." id="fifolambda"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="498" width="260" height="64" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Rule DLQ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-sqs-rule-dlq&lt;/font&gt;" tooltip="Rule DLQ — cpms-sqs-rule-dlq&#10;Catches events that never reach the ingestion queue (target invocation failure, throttling).&#10;The one gap not covered by the state machine's own error handling." id="routerdlq"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="270" width="260" height="64" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Ingestion DLQ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-sqs-ingestion-dlq.fifo&lt;/font&gt;&lt;br&gt;&lt;i&gt;after 5 failed receives&lt;/i&gt;" tooltip="Ingestion DLQ — cpms-sqs-ingestion-dlq.fifo&#10;Receives a message after 5 failed processing attempts (e.g. the consumer crashing or timing out), so one stuck event can't block that person's line forever.&#10;FIFO because its source queue is FIFO." id="ingdlq"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="384" width="260" height="64" as="geometry"/></mxCell></UserObject>
<mxCell id="e1" edge="1" parent="1" source="sources" target="eb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2" edge="1" parent="1" source="eb" target="router" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" edge="1" parent="1" source="router" target="ingfifo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="delivery failure" edge="1" parent="1" source="router" target="routerdlq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;fontColor=#B20000;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" edge="1" parent="1" source="ingfifo" target="fifolambda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5b" value="run failed 5x" edge="1" parent="1" source="ingfifo" target="ingdlq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;fontColor=#B20000;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<UserObject label="Express state machine &#8212; cpms-sfn-consent-sync (one for all sources)" tooltip="Express state machine — cpms-sfn-consent-sync&#10;One state machine for all sources, steps 1–7. Express (not Standard) because StartSyncExecution needs it.&#10;Invoked synchronously by the FIFO consumer. Created by deploy/setup_processing.py." id="sfn"><mxCell style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="640" width="380" height="750" as="geometry"/></mxCell></UserObject>
<mxCell id="e6" value="StartSyncExecution" edge="1" parent="1" source="fifolambda" target="sfn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<UserObject label="&lt;b&gt;1. Validate source event&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-lambda-validate-source&lt;/font&gt;" tooltip="1. Validate source event — cpms-lambda-validate-source&#10;JSON Schema check (by schemaVersion) + content checks: taxonomy codes, timestamp sanity. Returns { valid, errors }.&#10;Failure here means the source sent bad data → fail record + alarm.&#10;Dev: reads schema and taxonomy from cpms/ in S3 on every run." id="s1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sfn"><mxGeometry x="60" y="45" width="260" height="72" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;2. Transform to canonical&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-lambda-transform-canonical&lt;/font&gt;&lt;br&gt;&lt;i&gt;validates its own output&lt;/i&gt;" tooltip="2. Transform to canonical — cpms-lambda-transform-canonical&#10;One universal mapping for every source: maps preferences, derives legalBasis from purposeCode, restructures header/provenance, defaults correlationId to eventId.&#10;Derives topic opt-outs when a purpose is withdrawn.&#10;Validates its own output against canonical_consent.schema.json; anything off-contract raises (= our bug)." id="s2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sfn"><mxGeometry x="60" y="145" width="260" height="72" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;3. Filter stale items&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-lambda-filter-stale&lt;/font&gt;&lt;br&gt;&lt;i&gt;all stale &#8594; skipped_stale&lt;/i&gt;" tooltip="3. Filter stale items — cpms-lambda-filter-stale&#10;Reads the person's watermark (keeps its ETag) and drops any consent/preference item with capturedAt ≤ what was already sent.&#10;All items dropped → run ends as skipped_stale.&#10;Stops a late-arriving older decision rolling back a newer one at OneTrust." id="s3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="sfn"><mxGeometry x="60" y="245" width="260" height="72" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;4. Build OneTrust receipts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-lambda-build-payload&lt;/font&gt;&lt;br&gt;&lt;i&gt;validates its own output&lt;/i&gt;" tooltip="4. Build OneTrust receipts — cpms-lambda-build-payload&#10;Turns the filtered record into OneTrust Consent Receipt requests: one per distinct capturedAt, ≤ 20 purposes each; codes → OneTrust IDs via the taxonomy.&#10;Channels go as a custom preference per topic.&#10;Validates every request against schemas/onetrust_request.schema.json — the only check before OneTrust, which doesn't validate data types." id="s4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sfn"><mxGeometry x="60" y="345" width="260" height="72" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;5. Enqueue&lt;/b&gt;&lt;br&gt;&lt;i&gt;Map, in order &#183; native SQS&lt;/i&gt;" tooltip="5. Enqueue — Step Functions Map (MaxConcurrency 1) + native SQS&#10;SendMessage straight from the state machine, no Lambda: one message per request, strictly in order, MessageGroupId = person.&#10;Failure after retries fails the run, so SQS retries the event." id="s5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sfn"><mxGeometry x="60" y="445" width="260" height="72" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;6. Advance watermark&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-lambda-advance-watermark&lt;/font&gt;&lt;br&gt;&lt;i&gt;only after enqueue&lt;/i&gt;" tooltip="6. Advance watermark — cpms-lambda-advance-watermark&#10;Only after a successful enqueue. Merges the sent items' capturedAt into the watermark with a conditional PutObject (If-Match ETag / If-None-Match: *); re-reads and retries on 412.&#10;Never moves a watermark backwards. Shares lambdas/shared/watermark.py with step 3." id="s6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="sfn"><mxGeometry x="60" y="545" width="260" height="72" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;7. Write success record&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;native S3 PutObject&lt;/font&gt;&lt;br&gt;&lt;i&gt;sent / skipped_stale&lt;/i&gt;" tooltip="7. Write success record — native S3 PutObject&#10;Writes the run's full state and outcome (sent / skipped_stale) to cpms/success/&lt;eventId&gt;/&lt;run&gt;.json — no Lambda.&#10;Keyed by eventId so a result can be looked up from the event." id="s7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sfn"><mxGeometry x="60" y="645" width="260" height="72" as="geometry"/></mxCell></UserObject>
<mxCell id="e_s1_s2" edge="1" parent="sfn" source="s1" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s2_s3" edge="1" parent="sfn" source="s2" target="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s3_s4" edge="1" parent="sfn" source="s3" target="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s4_s5" edge="1" parent="sfn" source="s4" target="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s5_s6" edge="1" parent="sfn" source="s5" target="s6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e_s6_s7" edge="1" parent="sfn" source="s6" target="s7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<UserObject label="&lt;b&gt;S3 project bucket&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms/schemas/  cpms/taxonomy/&lt;/font&gt;&lt;br&gt;&lt;i&gt;read on every run (no cache in dev)&lt;/i&gt;" tooltip="S3 project bucket — cpms/schemas/, cpms/taxonomy/&#10;The existing bucket (AWS_BUCKET_NAME in .env.prod); no new buckets.&#10;Schemas are the validation input; the taxonomy holds valid purpose / topic / channel codes and their OneTrust IDs.&#10;Dev reads both on every run. Prod adds an ElastiCache (Redis) cache inside a VPC.&#10;Uploaded by deploy/upload_assets.py." id="refs"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="811" width="260" height="90" as="geometry"/></mxCell></UserObject>
<mxCell id="e_ref1" value="schema + taxonomy" edge="1" parent="1" source="refs" target="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="829"/><mxPoint x="440" y="721"/></Array></mxGeometry></mxCell>
<mxCell id="e_ref2" value="taxonomy + schema" edge="1" parent="1" source="refs" target="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="856"/><mxPoint x="500" y="821"/></Array></mxGeometry></mxCell>
<mxCell id="e_ref4" value="taxonomy + schema" edge="1" parent="1" source="refs" target="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="883"/><mxPoint x="560" y="1021"/></Array></mxGeometry></mxCell>
<UserObject label="&lt;b&gt;Outbound FIFO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-sqs-outbound.fifo&lt;/font&gt;&lt;br&gt;&lt;i&gt;OneTrust requests&lt;/i&gt;" tooltip="Outbound FIFO — cpms-sqs-outbound.fifo&#10;Holds complete OneTrust Consent Receipt requests (method, url, headers, body, correlationId) until they're dispatched — there's no paid live API access yet.&#10;MessageGroupId = person, so a future multi-worker dispatcher can't reorder one person's requests.&#10;Content-based dedup, high-throughput mode, 14-day retention (SQS max), redrive to the outbound DLQ after 5 receives." id="outfifo"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1085" width="240" height="72" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Outbound DLQ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-sqs-outbound-dlq.fifo&lt;/font&gt;&lt;br&gt;&lt;i&gt;dispatcher failed 5x&lt;/i&gt;" tooltip="Outbound DLQ — cpms-sqs-outbound-dlq.fifo&#10;Receives requests the dispatcher failed to deliver 5 times.&#10;Enqueue failures don't land here — they fail the run and SQS retries the event." id="outdlq"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1271" width="240" height="64" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-lambda-dispatcher&lt;/font&gt;&lt;br&gt;&lt;i&gt;adds token + signature, POSTs &#183; not built&lt;/i&gt;" tooltip="Dispatcher — cpms-lambda-dispatcher (not built)&#10;Will read the outbound queue; for each request fetch the collection point's token, replace the {{COLLECTION_POINT_JWT}} placeholder, sign the authorization JWT via KMS, and POST to OneTrust.&#10;The only component that will hold OneTrust credentials." id="dispatcher"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="1085" width="240" height="72" as="geometry"/></mxCell></UserObject>
<mxCell id="e13" value="SendMessage" edge="1" parent="1" source="s5" target="outfifo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e18" value="reads" edge="1" parent="1" source="outfifo" target="dispatcher" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e17" value="dispatcher failed 5x" edge="1" parent="1" source="outfifo" target="outdlq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;fontColor=#B20000;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<UserObject label="&lt;b&gt;S3 cpms/watermarks/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;&lt;sha256(email)&gt;.json&lt;/font&gt;&lt;br&gt;&lt;i&gt;last-sent capturedAt per item&lt;/i&gt;" tooltip="S3 cpms/watermarks/&lt;sha256(email)&gt;.json&#10;One object per person: the last-sent capturedAt per consent / preference item, plus the eventId of that decision.&#10;Read by step 3, written by step 6. Needed because FIFO only preserves arrival order — a late older decision would otherwise roll back a newer one.&#10;Also used by the test app's preference centre as a stand-in for reading OneTrust." id="watermark"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="1001" width="280" height="90" as="geometry"/></mxCell></UserObject>
<mxCell id="e_wmread" value="GetObject (+ETag)" edge="1" parent="1" source="watermark" target="s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;dashed=1;exitX=0;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="1019"/><mxPoint x="1120" y="921"/></Array></mxGeometry></mxCell>
<mxCell id="e_wmwrite" value="conditional PutObject" edge="1" parent="1" source="s6" target="watermark" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="1221"/><mxPoint x="1150" y="1073"/></Array></mxGeometry></mxCell>
<UserObject label="&lt;b&gt;S3 cpms/fail/&lt;eventId&gt;/&lt;/b&gt;&lt;br&gt;&lt;i&gt;record + failedStep&lt;/i&gt;" tooltip="S3 cpms/fail/&lt;eventId&gt;/&lt;run&gt;.json&#10;One record per data or logic failure (schema, content, canonical, payload build / validate), with the failed step and error detail.&#10;Paired with the failure alarm, not a DLQ — these won't fix themselves on retry." id="failbucket"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="1289" width="280" height="64" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Failure alarm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; face=&quot;Menlo&quot;&gt;cpms-alarm-failures&lt;/font&gt;&lt;br&gt;&lt;i&gt;metric CPMS/DataFailures&lt;/i&gt;" tooltip='Failure alarm — cpms-alarm-failures&#10;CloudWatch alarm on the CPMS/DataFailures metric, raised by any data / logic failure.&#10;The "someone should look at this" signal.&#10;Note: deploy/setup_processing.py ends with AccessDenied on this alarm until the IAM user gets cloudwatch:PutMetricAlarm.' id="alarm"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="1393" width="280" height="64" as="geometry"/></mxCell></UserObject>
<mxCell id="e15" value="data/logic failure (any step)" edge="1" parent="1" source="sfn" target="failbucket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;fontColor=#B20000;exitX=1;exitY=0.908;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e16" value="raises" edge="1" parent="1" source="failbucket" target="alarm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<UserObject label="&lt;b&gt;S3 cpms/success/&lt;eventId&gt;/&lt;/b&gt;&lt;br&gt;&lt;i&gt;full run record + outcome&lt;/i&gt;" tooltip="S3 cpms/success/&lt;eventId&gt;/&lt;run&gt;.json&#10;One record per successful run: the event, canonical record, generated OneTrust requests, outcome and timestamp.&#10;The test app reads it to show what CPMS sent." id="successbucket"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="1450" width="260" height="56" as="geometry"/></mxCell></UserObject>
