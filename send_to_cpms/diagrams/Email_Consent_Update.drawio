<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Email_Consent_Update — Marketo email link → OneTrust's preference centre (proposed)" style="text;fontSize=20;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1260" height="30" as="geometry"/></mxCell>
<mxCell id="lane_mkto" value="Marketo" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="300" height="650" as="geometry"/></mxCell>
<mxCell id="lane_app" value="CPMS_Router (AWS · not built)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="50" width="580" height="650" as="geometry"/></mxCell>
<mxCell id="lane_ot" value="OneTrust" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="50" width="300" height="650" as="geometry"/></mxCell>
<UserObject label='&lt;b&gt;Marketing email&lt;/b&gt;&lt;br&gt;&lt;i&gt;Manage your preferences →&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;https://&amp;lt;cpms-host&amp;gt;/marketo/preferences&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;?ref={{lead.cpmsPrefRef}}&lt;/font&gt;' tooltip="Marketing email sent by Marketo&#10;The footer's &quot;Manage your preferences&quot; link points at CPMS_Router's Marketo route, /marketo/preferences, with the lead's pre-encrypted lead ID as ref.&#10;cpmsPrefRef is filled on the lead beforehand (design.md → &quot;The email link's ref&quot;); Marketo just prints it." id="m_email"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_mkto"><mxGeometry x="20" y="60" width="260" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;REST API: Get Lead by Id&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /rest/v1/lead/&amp;lt;id&amp;gt;.json&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;?fields=email,cpmsPrefRef&lt;/font&gt;' tooltip="Marketo REST API — Get Lead by Id&#10;GET https://&amp;lt;munchkin-id&amp;gt;.mktorest.com/rest/v1/lead/&amp;lt;leadId&amp;gt;.json?fields=email,cpmsPrefRef&#10;OAuth client-credentials token. Returns the lead's email and its stored cpmsPrefRef." id="m_api"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_mkto"><mxGeometry x="20" y="210" width="260" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;1. Validate &amp;amp; decrypt ref&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /marketo/preferences&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-lambda-router-marketo&lt;/font&gt;' tooltip="CPMS_Router Marketo route — GET /marketo/preferences (API Gateway cpms-apigw-router) → Lambda cpms-lambda-router-marketo&#10;The route itself says the ref is a Marketo pre-encrypted lead ID — no source parameter. Its own Lambda, secrets and throttling, separate from the website route.&#10;1. Reject a ref that's missing, over ~200 characters or not shaped v&amp;lt;n&amp;gt;.&amp;lt;base64url&amp;gt;.&amp;lt;base64url&amp;gt;.&#10;2. Pick the key for its version (unknown version → reject).&#10;3. AES-256-GCM decrypt with that key, the IV and additional data &quot;cpms-pref-ref:v&amp;lt;n&amp;gt;&quot;. Tag doesn't verify → forged or edited → reject.&#10;4. The plaintext must be a numeric lead ID.&#10;Every rejection: one generic &quot;invalid or expired link&quot; page, counted so guessing shows up." id="a_decrypt"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="65" width="260" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;cpms-secret-pref-ref-key&lt;/font&gt;' tooltip="cpms-secret-pref-ref-key&#10;256-bit AES key(s) by version — the current one plus any still accepted during a rotation. Readable only by cpms-lambda-router-marketo and the ref issuer, cached in memory." id="a_key"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_app"><mxGeometry x="320" y="70" width="240" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;2. Marketo lookup&lt;/b&gt;&lt;br&gt;&lt;i&gt;email; stored cpmsPrefRef must match&lt;/i&gt;" tooltip="2. Marketo lookup&#10;Get Lead by Id for the decrypted lead ID, asking for email and cpmsPrefRef.&#10;No lead → reject. Stored cpmsPrefRef differs from the link's → the link was revoked → reject.&#10;Never log the ref, lead ID and email together in plain text." id="a_lookup"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="210" width="260" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;3. Get OneTrust magic link&lt;/b&gt;&lt;br&gt;&lt;i&gt;email → link token&lt;/i&gt;" tooltip="3. OneTrust magic link&#10;Calls Get Data Subject Token with the email as the identifier header; appends the URL-encoded token to the preference centre URL.&#10;Backend only — the token request never happens in the browser." id="a_magic"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="360" width="260" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;4. Redirect&lt;/b&gt;&lt;br&gt;&lt;i&gt;302 to the magic link&lt;/i&gt;" tooltip="4. Redirect&#10;The browser is sent to OneTrust's preference centre with the person's magic link.&#10;Our side stops here: no settings are read or changed, and nothing is sent to CPMS." id="a_redirect"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_app"><mxGeometry x="20" y="490" width="260" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Get Data Subject Token&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;GET /rest/api/consent/v4/&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;datasubjects/linktokens&lt;/font&gt;&lt;br&gt;&lt;i&gt;header identifier: email&lt;/i&gt;' tooltip="OneTrust — Get Data Subject Token&#10;GET https://&amp;lt;hostname&amp;gt;/rest/api/consent/v4/datasubjects/linktokens, header identifier: &amp;lt;email&amp;gt;, OAuth scope CONSENT.&#10;Returns token, createdDate, expiryDate. To confirm: what it returns for someone with no token yet." id="o_token"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="350" width="260" height="90" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Hosted preference centre&lt;/b&gt;&lt;br&gt;&lt;i&gt;person reviews and changes preferences;&lt;/i&gt;&lt;br&gt;&lt;i&gt;OneTrust records the change&lt;/i&gt;" tooltip="OneTrust's hosted preference centre&#10;Opens for the person in the magic link. They see their current settings and change them; OneTrust records the change itself.&#10;Which purposes and topics appear, and how &quot;opt out of all&quot; behaves, is OneTrust configuration." id="o_pc"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="480" width="260" height="80" as="geometry"/></mxCell></UserObject>
<UserObject label='&lt;b&gt;Consent fanout&lt;/b&gt;&lt;br&gt;&lt;i&gt;OneTrust → SFMC, OneTrust → AEP&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px" face="Menlo"&gt;consent_fanout/&lt;/font&gt;' tooltip="Consent fanout (consent_fanout/)&#10;Once OneTrust has recorded the change, it reaches downstream systems: OT → SFMC (OneTrust workflow) and OT → AEP (OneTrust Integration source)." id="o_fanout"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="lane_ot"><mxGeometry x="20" y="590" width="260" height="50" as="geometry"/></mxCell></UserObject>
<mxCell id="x1" value="click" edge="1" parent="1" source="m_email" target="a_decrypt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
