<mxCell id="x5" value="email" edge="1" parent="1" source="a_lookup" target="a_magic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x6" value="identifier: email" edge="1" parent="1" source="a_magic" target="o_token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x7" value="" edge="1" parent="1" source="a_magic" target="a_redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="x8" value="302 · magic link" edge="1" parent="1" source="a_redirect" target="o_pc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=default;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
